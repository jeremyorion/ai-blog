# /etc/caddy/Caddyfile — Caddy obtains and renews HTTPS certificates automatically.
example.com {
	redir https://www.example.com{uri} 301
}

www.example.com {
	root * /var/www/blog
	encode zstd gzip
	file_server

	# Pretty URLs: /blog/post -> /blog/post/index.html
	try_files {path} {path}/index.html {path}.html

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# Long cache for fingerprinted assets, short for HTML
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=300"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
